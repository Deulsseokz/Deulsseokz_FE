{
  "cli": {
    "version": ">= 14.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BASE_URL": "https://melog.store",
        "EXPO_PUBLIC_META_APP_ID": "1441654617113010"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BASE_URL": "https://melog.store",
        "EXPO_PUBLIC_META_APP_ID": "1441654617113010"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
